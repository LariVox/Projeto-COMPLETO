@model ProjetoCompleto.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">Logina</h4>
            </div>
            <div class="card-body">
                @if (TempData["Sucesso"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Sucesso"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="form-control" placeholder="Digite seu email" autofocus />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Senha"></label>
                        <input asp-for="Senha" class="form-control" placeholder="Digite sua senha" />
                        <span asp-validation-for="Senha" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="LembrarMe" type="checkbox" class="form-check-input" />
                        <label asp-for="LembrarMe" class="form-check-label"></label>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-sign-in-alt"></i> Entrar
                        </button>
                    </div>
                </form>

                <hr />

                <div class="text-center">
                    <p>Não possui uma conta? <a asp-action="Cadastro">Cadastre-se</a></p>
                    <p><a href="#">Esqueci minha senha</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}